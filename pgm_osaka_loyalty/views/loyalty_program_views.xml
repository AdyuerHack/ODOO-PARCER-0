<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_program_view_form_inherit_osaka" model="ir.ui.view">
        <field name="name">loyalty.program.view.form.inherit.osaka</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='program_type']/.." position="after">
                <field name="osaka_program_type" />
                <field name="validez_puntos_meses" invisible="osaka_program_type == 'otro'" />
            </xpath>
        </field>
    </record>
</odoo>
