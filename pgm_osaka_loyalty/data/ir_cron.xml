<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Diario de Vencimientos -->
        <record id="ir_cron_expire_osaka_points" model="ir.cron">
            <field name="name">Osaka: Expirar Puntos Vencidos</field>
            <field name="model_id" ref="loyalty.model_loyalty_card"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_osaka_points()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Mensual de Notificaciones (Día 1) -->
        <record id="ir_cron_monthly_osaka_notification" model="ir.cron">
            <field name="name">Osaka: Notificación Mensual de Puntos (Día 1)</field>
            <field name="model_id" ref="loyalty.model_loyalty_card"/>
            <field name="state">code</field>
            <field name="code">model._cron_monthly_notification()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <!-- Programar para que corra el día 1 del próximo mes -->
            <field name="nextcall" eval="(DateTime.now() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d 08:00:00')"/>
        </record>
    </data>
</odoo>
