<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pgm_wms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pgm.wms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="WMS Osaka" name="wms_osaka">
                    <setting string="Seguimiento WMS" help="Configuraciones de Inactividad WMS">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wms_inactivity_minutes" class="col-lg-3 o_light_label"/>
                                <field name="wms_inactivity_minutes"/>
                            </div>
                            <div class="row mt16">
                                <label for="wms_dead_time_closure_hours" class="col-lg-3 o_light_label"/>
                                <field name="wms_dead_time_closure_hours"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
