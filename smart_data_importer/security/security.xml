<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">


        <record id="group_smart_importer_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_smart_importer_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_smart_importer_user'))]"/>
        </record>

        <!-- Automatically assign the admin group to the admin users -->
        <record id="base.user_root" model="res.users">
            <field name="groups_id" eval="[(4, ref('smart_data_importer.group_smart_importer_admin'))]"/>
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('smart_data_importer.group_smart_importer_admin'))]"/>
        </record>

        <record id="rule_import_session_personal" model="ir.rule">
            <field name="name">Personal Import Sessions</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_smart_importer_user'))]"/>
        </record>

        <record id="rule_import_session_all" model="ir.rule">
            <field name="name">All Import Sessions</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_smart_importer_admin'))]"/>
        </record>
    </data>
</odoo>
