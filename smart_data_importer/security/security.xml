<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_smart_importer" model="ir.module.category">
            <field name="name">Smart Importer</field>
            <field name="description">Helps you import and map your data.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_smart_importer_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_smart_importer"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_smart_importer_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_smart_importer"/>
            <field name="implied_ids" eval="[(4, ref('group_smart_importer_user'))]"/>
        </record>

        <record id="rule_import_session_personal" model="ir.rule">
            <field name="name">Personal Import Sessions</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_smart_importer_user'))]"/>
        </record>

        <record id="rule_import_session_all" model="ir.rule">
            <field name="name">All Import Sessions</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_smart_importer_admin'))]"/>
        </record>
    </data>
</odoo>
