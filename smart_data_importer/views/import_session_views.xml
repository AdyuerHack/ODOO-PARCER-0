<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_import_session" model="ir.actions.act_window">
        <field name="name">Import Sessions</field>
        <field name="res_model">import.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new import session.
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_import_session_list" model="ir.ui.view">
        <field name="name">import.session.list</field>
        <field name="model">import.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="create_date"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'analyzing'" 
                       decoration-success="state == 'mapped'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_import_session_form" model="ir.ui.view">
        <field name="name">import.session.form</field>
        <field name="model">import.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_analyze" string="Analyze" type="object" class="btn-primary" 
                            invisible="state != 'draft' or not file"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,analyzing,mapped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" widget="binary" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="encoding" readonly="1" invisible="not encoding"/>
                            <field name="delimiter" readonly="1" invisible="not delimiter"/>
                            <field name="header_row_index" readonly="1" invisible="not encoding"/>
                            <field name="total_rows" readonly="1" invisible="not total_rows"/>
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page name="mappings" string="Column Mapping">
                            <field name="column_mapping_ids" readonly="1">
                                <list decoration-danger="is_conflict">
                                    <field name="source_header"/>
                                    <field name="target_field_name"/>
                                    <field name="source"/>
                                    <field name="confidence"/>
                                    <field name="is_ignored" widget="boolean_toggle"/>
                                    <field name="is_conflict" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="preview" string="Data Preview" invisible="state == 'draft'">
                            <field name="preview_data" widget="preview_table" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
