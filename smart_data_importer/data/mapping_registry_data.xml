        <!-- Spanish Synonyms -->
        <record id="mapping_es_nit" model="mapping.registry">
            <field name="synonym">NIT</field>
            <field name="model_id" search="[('model', '=', 'res.partner')]"/>
            <field name="field_id" search="[('name', '=', 'vat'), ('model_id.model', '=', 'res.partner')]"/>
            <field name="language">es</field>
            <field name="priority">100</field>
